# MongoDB connection string
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/nursehub?retryWrites=true&w=majority

# JWT secret (generate a strong random string in production)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Server environment
NODE_ENV=development
PORT=3000

# Allowed frontend origin (for CORS)
CLIENT_URL=http://localhost:5173

# GitHub Models / Azure AI token for AI Study Assistant (optional)
# If not provided, the assistant will use safe local fallback responses.
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx

# YouTube Data API key for course video enrichment (optional)
YOUTUBE_API_KEY=AIzaSxxxxxxxxxxxxxxxxxxx

# Test database URI (optional; if omitted tests use mongodb-memory-server)
MONGODB_TEST_URI=mongodb://localhost:27017/nursehub_test
